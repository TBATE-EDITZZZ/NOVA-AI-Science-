# Secret values are server-only. Never add real credentials to this file or commit them.
# In managed preview/production, DATABASE_URL is supplied by the enabled platform database.
DATABASE_URL=
# Configure through the platform's protected secret input to enable Gemini.
GEMINI_API_KEY=
# Optional Gemini model override; default is gemini-3.8-flash.
GEMINI_MODEL=
# Optional actual public origin for absolute SEO/social metadata. Leave unset rather than guessing.
PUBLIC_SITE_URL=
