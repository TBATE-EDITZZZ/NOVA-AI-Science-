{
  "name": "nova-science-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @nova/server dev",
    "build": "pnpm --filter @nova/client build && pnpm --filter @nova/server build",
    "start": "pnpm --filter @nova/server start",
    "typecheck": "pnpm --filter @nova/shared typecheck && pnpm --filter @nova/client typecheck && pnpm --filter @nova/server typecheck",
    "db:migrate": "pnpm --filter @nova/server db:migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
